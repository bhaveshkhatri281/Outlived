{
  "name": "outlived",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "split": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/split-products.ts",
    "split:sample": "npm run split -- --sample 2",
    "typecheck": "tsc --noEmit",
    "editorial": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/make-editorial.ts",
    "qa": "node scripts/qa/capture.mjs",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
    "qa:report": "node scripts/qa/report.mjs",
    "cutout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/cutout-products.ts",
    "cutout:sample": "npm run cutout -- --sample 2"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.182.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
